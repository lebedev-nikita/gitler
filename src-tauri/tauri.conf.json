{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gitler",
  "version": "0.2.0-rc.1",
  "identifier": "dev.gitler.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Gitler", "width": 1480, "height": 940, "minWidth": 900, "minHeight": 600 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "See every branch and every worktree",
    "category": "DeveloperTool",
    "macOS": { "signingIdentity": "-" },
    "windows": { "wix": { "version": "0.2.0.1" } },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
